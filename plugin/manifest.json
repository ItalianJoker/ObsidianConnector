{
  "id": "obsidian-connector",
  "name": "Obsidian Connector",
  "version": "1.1.0",
  "manifestVersion": 1,
  "minSupVersion": "14.0.0",
  "description": "Link Super Productivity projects to existing Obsidian pages. Vault folder tree, on-demand linked-project search, desktop + mobile. Never creates a new page.",
  "author": "Luca",
  "homepage": "https://github.com/ItalianJoker/ObsidianConnector",
  "icon": "icon.svg",
  "iFrame": true,
  "sidePanel": true,
  "type": "standard",
  "hooks": [
    "persistedDataChanged",
    "projectListUpdate",
    "workContextChange",
    "languageChange"
  ],
  "permissions": [
    "getAllProjects",
    "persistDataSynced",
    "loadSyncedData",
    "showSnack",
    "openDialog",
    "showIndexHtmlAsView",
    "nodeExecution"
  ],
  "nodeScriptConfig": {
    "timeout": 20000
  },
  "i18n": {
    "languages": ["en"]
  }
}
